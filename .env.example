# Copy to .env and fill in. .env is excluded from the project — never share real keys.

# --- Google Gemini (the only LLM provider) ---------------------------------
GOOGLE_API_KEY=
# gemini-2.5-flash is no longer available to new API users (404 NOT_FOUND, verified 2026-09-28)
GEMINI_MODEL=gemini-3.8-flash
# DeepEval LLM-as-judge model (defaults to GEMINI_MODEL)
GEMINI_JUDGE_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.0
# Client-side rate limit shared by every Gemini call (free tier returns 429 on bursts)
GEMINI_RPM=8
# Cost estimate inputs for golden_signals.json (USD per 1M tokens). VERIFY against current
# Gemini pricing for the model above; these defaults were set for gemini-2.5-flash.
GEMINI_INPUT_PRICE_PER_MTOK=0.30
GEMINI_OUTPUT_PRICE_PER_MTOK=2.50

# --- Business rules --------------------------------------------------------
# USD value of a credit/discount above which the offer is routed to human approval
OFFER_APPROVAL_THRESHOLD=50

# --- Resilience / loop guards ----------------------------------------------
LLM_TIMEOUT_S=60
TOOL_TIMEOUT_S=20
MAX_RETRIES=3
GRAPH_RECURSION_LIMIT=25
RAG_MAX_REWRITES=2

# --- Retrieval / memory (local embeddings) ---------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Arize Phoenix (local, in-process) -------------------------------------
PHOENIX_PROJECT_NAME=retention-copilot
PHOENIX_PORT=6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_WORKING_DIR=.phoenix

# --- Third-party telemetry off ---------------------------------------------
DEEPEVAL_TELEMETRY_OPT_OUT=YES
ANONYMIZED_TELEMETRY=False
